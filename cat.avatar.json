          "roundness": 0.25
        },
        "position": [-68, -108, 10],
        "rotation": [0, 0, -26]
      },
      {
        "id": "ear-right",
        "name": "Right Ear",
        "surface": {
          "type": "cone",
          "width": 64,
          "height": 78,
          "depth": 50,
          "roundness": 0.25
        },
        "position": [68, -108, 10],
        "rotation": [0, 0, 26]
      },
      {
        "id": "nose",
