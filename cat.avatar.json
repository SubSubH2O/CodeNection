  "expressions": {
    "neutral": {
      "head": { "x": 0, "y": 0, "z": 0 },
      "eyes": {
        "left": { "width": 22, "height": 34, "x": 0, "y": -4, "angle": 0 },
        "right": { "width": 22, "height": 34, "x": 0, "y": -4, "angle": 0 },
        "spacing": 42
      },
      "perspective": 1,
      "motion": { "eyes": "subtle", "body": "breathing" }
    },
    "content": {
      "head": { "x": 0, "y": 0, "z": 4 },
      "eyes": {
        "left": { "width": 26, "height": 12, "x": 0, "y": 2, "angle": 12 },
        "right": { "width": 26, "height": 12, "x": 0, "y": 2, "angle": -12 },
        "spacing": 42
      },
      "perspective": 1,
      "motion": { "eyes": "none", "body": "breathing" }
    },
    "drowsy": {
      "head": { "x": -8, "y": 0, "z": 0 },
      "eyes": {
        "left": { "width": 24, "height": 16, "x": 0, "y": 6, "angle": -5 },
        "right": { "width": 24, "height": 16, "x": 0, "y": 6, "angle": 5 },
        "spacing": 40
      },
      "perspective": 1,
      "motion": { "eyes": "subtle", "body": "breathing" }
    },
    "sleeping": {
      "head": { "x": -14, "y": 0, "z": -6 },
      "eyes": {
        "left": { "width": 28, "height": 4, "x": 0, "y": 8, "angle": 0 },
        "right": { "width": 28, "height": 4, "x": 0, "y": 8, "angle": 0 },
        "spacing": 42
      },
      "perspective": 1,
      "motion": { "eyes": "none", "body": "breathing" }
    },
    "alert": {
      "head": { "x": 6, "y": 0, "z": 0 },
      "eyes": {
        "left": { "width": 28, "height": 42, "x": 0, "y": -8, "angle": 0 },
        "right": { "width": 28, "height": 42, "x": 0, "y": -8, "angle": 0 },
        "spacing": 46
      },
      "perspective": 1,
      "motion": { "eyes": "subtle", "body": "none" }
    }
  },
  "expressionOrder": ["neutral", "content", "drowsy", "sleeping", "alert"],
  "animations": {
    "idle": {
      "fps": 30,
      "loop": true,
      "blink": { "enabled": true, "interval": 4.2, "duration": 0.18 },
      "steps": [
        { "expression": "neutral", "duration": 3.0, "transition": "ease-in-out" },
        { "expression": "content", "duration": 2.5, "transition": "ease-in-out" }
      ]
    },
    "resting": {
      "fps": 30,
      "loop": true,
      "blink": { "enabled": false, "interval": 0, "duration": 0 },
      "steps": [
        { "expression": "drowsy", "duration": 4.0, "transition": "ease-in-out" },
        { "expression": "sleeping", "duration": 4.0, "transition": "ease-in-out" }
      ]
    }
  },
  "animationOrder": ["idle", "resting"]
