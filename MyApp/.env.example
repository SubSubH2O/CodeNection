# Both values below are PUBLIC client keys and are safe in the app bundle.
# Copy to `.env` and fill in from your Supabase project settings (API tab).
# Leave them unset and LoadTree runs its local conversation with no network.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The Gemini key is NOT set here. It lives only in the Edge Function secrets:
#   supabase secrets set GEMINI_API_KEY=your-key
